class SparseSet:
    def __init__(self, minimum: int, maximum: int) -> None: ...

    @property
    def size(self) -> int: ...

    @property
    def min(self) -> int: ...

    @property
    def max(self) -> int: ...

    def contains(self, value: int) -> bool: ...
    def remove(self, value: int) -> bool: ...
    def values(self) -> list[int]: ...

class StateManager:
    def __init__(self) -> None: ...

    @property
    def level(self) -> int: ...

    def save(self) -> None: ...
    def restore(self) -> None: ...

class StateInt:
    def __init__(self, manager: StateManager, value: int) -> None: ...

    @property
    def value(self) -> int: ...

    def set(self, value: int) -> None: ...

class StateSparseSet:
    def __init__(
        self, manager: StateManager, minimum: int, maximum: int
    ) -> None: ...

    @property
    def size(self) -> int: ...

    @property
    def min(self) -> int: ...

    @property
    def max(self) -> int: ...

    def contains(self, value: int) -> bool: ...
    def remove(self, value: int) -> bool: ...
    def remove_below(self, value: int) -> bool: ...
    def remove_above(self, value: int) -> bool: ...
    def values(self) -> list[int]: ...

class Inconsistency(Exception): ...

class Solver:
    def __init__(self, state_manager: StateManager | None = None) -> None: ...

    @property
    def state_manager(self) -> StateManager: ...
    def post(self, constraint: Constraint) -> None: ...
    def fix_point(self) -> None: ...
    def minimize(self, variable: IntVar) -> Minimize: ...

class Constraint: ...

class IntVar:
    def __init__(
        self,
        solver: Solver,
        minimum: int,
        maximum: int,
        name: str | None = None,
    ) -> None: ...

    @property
    def solver(self) -> Solver: ...
    @property
    def min(self) -> int: ...
    @property
    def max(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def is_fixed(self) -> bool: ...
    @property
    def value(self) -> int: ...

    def values(self) -> list[int]: ...
    def contains(self, value: int) -> bool: ...
    def remove(self, value: int) -> None: ...
    def fix(self, value: int) -> None: ...
    def remove_below(self, value: int) -> None: ...
    def remove_above(self, value: int) -> None: ...

class BoolVar(IntVar):
    def __init__(self, solver: Solver, name: str | None = None) -> None: ...

    @property
    def is_true(self) -> bool: ...
    @property
    def is_false(self) -> bool: ...

def not_equal(x: IntVar, y: IntVar, offset: int = 0) -> Constraint: ...
def equal(x: IntVar, y: IntVar) -> Constraint: ...
def all_different(variables: list[IntVar]) -> Constraint: ...
def circuit(variables: list[IntVar]) -> Constraint: ...
def element(values: list[int], index: IntVar) -> IntVar: ...
def sum_var(variables: list[IntVar]) -> IntVar: ...

class Minimize:
    @property
    def best_value(self) -> int | None: ...

class SearchStatistics:
    nodes: int
    failures: int
    solutions: int
    completed: bool
    elapsed_seconds: float

class DFSearch:
    def __init__(
        self,
        solver: Solver,
        variables: list[IntVar],
        value_order: list[list[int]] | None = None,
    ) -> None: ...

    @property
    def solutions(self) -> list[list[int]]: ...

    def solve(self, *, time_limit: float | None = None) -> SearchStatistics: ...
    def optimize(
        self, objective: Minimize, *, time_limit: float | None = None
    ) -> SearchStatistics: ...
