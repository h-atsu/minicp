class SparseSet:
    def __init__(self, minimum: int, maximum: int) -> None: ...

    @property
    def size(self) -> int: ...

    @property
    def min(self) -> int: ...

    @property
    def max(self) -> int: ...

    def contains(self, value: int) -> bool: ...
    def remove(self, value: int) -> bool: ...
    def values(self) -> list[int]: ...

class StateManager:
    def __init__(self) -> None: ...

    @property
    def level(self) -> int: ...

    def save(self) -> None: ...
    def restore(self) -> None: ...

class StateInt:
    def __init__(self, manager: StateManager, value: int) -> None: ...

    @property
    def value(self) -> int: ...

    def set(self, value: int) -> None: ...

class StateSparseSet:
    def __init__(
        self, manager: StateManager, minimum: int, maximum: int
    ) -> None: ...

    @property
    def size(self) -> int: ...

    @property
    def min(self) -> int: ...

    @property
    def max(self) -> int: ...

    def contains(self, value: int) -> bool: ...
    def remove(self, value: int) -> bool: ...
    def remove_below(self, value: int) -> bool: ...
    def remove_above(self, value: int) -> bool: ...
    def values(self) -> list[int]: ...

class Inconsistency(Exception): ...

class Solver:
    def __init__(self, state_manager: StateManager | None = None) -> None: ...

    @property
    def state_manager(self) -> StateManager: ...

class IntVar:
    def __init__(
        self,
        solver: Solver,
        minimum: int,
        maximum: int,
        name: str | None = None,
    ) -> None: ...

    @property
    def solver(self) -> Solver: ...
    @property
    def min(self) -> int: ...
    @property
    def max(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def is_fixed(self) -> bool: ...
    @property
    def value(self) -> int: ...

    def values(self) -> list[int]: ...
    def contains(self, value: int) -> bool: ...
    def remove(self, value: int) -> None: ...
    def fix(self, value: int) -> None: ...
    def remove_below(self, value: int) -> None: ...
    def remove_above(self, value: int) -> None: ...

class BoolVar(IntVar):
    def __init__(self, solver: Solver, name: str | None = None) -> None: ...

    @property
    def is_true(self) -> bool: ...
    @property
    def is_false(self) -> bool: ...

class TspStatistics:
    @property
    def nodes(self) -> int: ...
    @property
    def failures(self) -> int: ...
    @property
    def solutions(self) -> int: ...
    @property
    def completed(self) -> bool: ...
    @property
    def elapsed_seconds(self) -> float: ...

class TspResult:
    @property
    def improving_solutions(self) -> list[tuple[int, list[int]]]: ...
    @property
    def statistics(self) -> TspStatistics: ...

def solve_tsp(
    distances: list[list[int]], time_limit: float | None = None
) -> TspResult: ...
